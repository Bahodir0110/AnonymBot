# ==========================================
# Tash Tech Rector Anonymous Telegram Bot
# Environment Configuration Example
# ==========================================

# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Rector Telegram Chat ID (Can be a personal user ID, private group ID, or channel ID)
# e.g., personal: 123456789 or group/supergroup: -1001234567890
RECTOR_CHAT_ID=-1001234567890

# Optional: Topic / Thread ID if RECTOR_CHAT_ID is a forum supergroup
# Leave empty or omit if not using supergroup topics
RECTOR_THREAD_ID=

# Cooldown period in seconds before a student can submit another appeal
RATE_LIMIT_SECONDS=60

# Path to SQLite database file
DB_PATH=data/bot.db

# Timezone for appeal timestamps (Tashkent is UTC+5)
TIMEZONE=Asia/Tashkent

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
